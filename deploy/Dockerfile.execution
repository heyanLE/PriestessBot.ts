FROM node:22-bookworm-slim

ARG DEBIAN_MIRROR=http://deb.debian.org

# SDK filesystem operations need GNU utilities. Tool commands also commonly
# download archives and parse PDFs; install these once, outside model tasks.
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip curl ca-certificates git unzip zip jq poppler-utils \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
WORKDIR /workspace/files
# DockerSandboxClient supplies the numeric UID/GID of the service user.
