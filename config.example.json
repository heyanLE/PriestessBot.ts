{
  "runtime": "priestess-ts",
  "schemaVersion": 1,
  "connections": [{"id": "default", "apiKeyEnv": "OPENAI_API_KEY", "protocol": "responses"}],
  "agents": [{
    "id": "assistant", "displayName": "普瑞赛斯", "engine": "agents_sdk", "model": "gpt-4.1-mini", "connectionId": "default",
    "instructions": "你是普瑞赛斯。根据当前发送者的问题提供准确、有用的帮助。",
    "capabilities": ["chat", "memory.read", "memory.write", "knowledge.read", "conversation.stop"],
    "resources": {"memoryLibraries": ["default"], "knowledgeLibraries": ["default"], "tools": ["memory_recall", "memory_save", "memory_delete", "knowledge_search"]},
    "memoryExtraction": {"enabled": false}, "approvalTools": []
  }],
  "platforms": [
    {"id": "telegram", "type": "telegram", "displayName": "Telegram", "enabled": false, "tokenEnv": "TELEGRAM_BOT_TOKEN"},
    {"id": "napcat", "type": "napcat", "displayName": "QQ / NapCat", "enabled": false, "websocketUrl": "ws://127.0.0.1:3001", "apiBase": "http://127.0.0.1:3000", "accessTokenEnv": "NAPCAT_TOKEN"},
    {"id": "weixin", "type": "weixin", "displayName": "微信 iLink", "enabled": false, "tokenEnv": "WEIXIN_TOKEN"}
  ],
  "memoryLibraries": [{"id": "default", "displayName": "默认记忆库"}],
  "knowledgeLibraries": [{"id": "default", "displayName": "默认知识库"}],
  "grants": [],
  "flow": {"routing": {"defaultAgentId": "assistant", "rules": []}}
}
